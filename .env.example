# 会话签名密钥：用于给登录令牌签名。请改成一段随机的长字符串（越长越好）。
# 生成方法示例（任选其一）：
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 未设置时会使用不安全的默认值，切勿在正式环境这样做。
APP_SESSION_SECRET=

# 数据文件位置（JSON）。默认 ./data/store.json。
# 部署到有持久磁盘的平台时，指向持久目录，避免重启后数据丢失。
# DATA_FILE=./data/store.json

# 监听端口。多数托管平台会自动注入 PORT，本地默认 8000。
# PORT=8000

# 监听地址。默认 0.0.0.0（对外可访问）。本地想只对自己开放可设 127.0.0.1。
# HOST=0.0.0.0

# 钉钉文档备份（均只配置在服务端，绝不能放进 VITE_ 前缀变量）
# 企业内部应用的 AppKey 与 AppSecret，应用需开通知识库文档写权限。
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# 用于创建文档的钉钉用户 unionId，以及该用户可写入的知识库 ID。
DINGTALK_OPERATOR_ID=
DINGTALK_WORKSPACE_ID=
